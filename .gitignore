# This repo lives inside LeRobot's data folder (~/.cache/huggingface/lerobot), next to calibration/,
# runs/ and other things that must not be committed. So everything is ignored and the project's own
# files are listed back in below. A NEW FILE OR FOLDER MUST BE ADDED HERE TO BE COMMITTED.
*
!.gitignore
!README.md
!requirements.txt

# local scripts that belong to the project (were silently ignored before)
!full_pipeline.py
!qr_calibrate.py
!camera_transform.npy
!calibration.json

# arm tools at the top level (David's pipeline and joint offsets)
!IK_control.py
!fine_joint_offsets.py
!fine_joint_calibration_gui.py
!Full_pipeline.py
!pipeline_control.py
!modified_frpso_ik.py
!rrt_connect.py
!set_so101_joint_positions.py
!calibration/
calibration/*
!calibration/robots/
calibration/robots/*
!calibration/robots/so_follower/
calibration/robots/so_follower/*
!calibration/robots/so_follower/fine_joint_offsets.json

!robot/
robot/*
!robot/*.py
!robot/sort_rules.json

!yolo_dataset/
yolo_dataset/*
!yolo_dataset/*.py
!yolo_dataset/classes.txt
!yolo_dataset/roi.json
!yolo_dataset/images/
yolo_dataset/images/*
!yolo_dataset/images/*.jpg
!yolo_dataset/images/*.jpeg
!yolo_dataset/images/*.png
!yolo_dataset/labels/
yolo_dataset/labels/*
!yolo_dataset/labels/*.txt

!point_cloud_matching/
point_cloud_matching/*
!point_cloud_matching/*.py
!point_cloud_matching/*.md
!point_cloud_matching/cases/
!point_cloud_matching/cases/**

!stl/
stl/*
!stl/*.stl
!stl/*.3mf
!stl/*.py

!docs/
docs/*
!docs/*.pdf
