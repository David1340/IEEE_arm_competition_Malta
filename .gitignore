# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Run outputs (YOLO training runs, calibration pictures, logs, recordings)
runs/
outputs/
logs/
*.log

# Datasets are kept out of this branch
datasets/
dev/dataset_tools/*/images/
dev/dataset_tools/*/labels/
point_cloud_mathing/

# Trained YOLO weights: large, copied onto each PC (see models/yolo/README.md)
models/yolo/*.pt
models/yolo/*.onnx

# Derived from config/calibration/camera.yaml on every save; never edit by hand
config/calibration/camera_transform.npy

# Temporary files written while saving config atomically
*.tmp
*.bak
