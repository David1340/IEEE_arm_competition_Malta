# This repo lives inside LeRobot's data folder (~/.cache/huggingface/lerobot), next to calibration/,
# runs/ and other things that must not be committed. So everything is ignored and the project's own
# files are listed back in below. A NEW FILE OR FOLDER MUST BE ADDED HERE TO BE COMMITTED.
*
!.gitignore
!README.md
!requirements.txt

# local scripts that belong to the project (were silently ignored before)
!full_pipeline.py
!qr_calibrate.py
!camera_transform.npy

!robot/
robot/*
!robot/*.py

!yolo_dataset/
yolo_dataset/*
!yolo_dataset/*.py
!yolo_dataset/classes.txt
!yolo_dataset/roi.json
!yolo_dataset/images/
yolo_dataset/images/*
!yolo_dataset/images/*.jpg
!yolo_dataset/images/*.jpeg
!yolo_dataset/images/*.png
!yolo_dataset/labels/
yolo_dataset/labels/*
!yolo_dataset/labels/*.txt

!point_cloud_matching/
point_cloud_matching/*
!point_cloud_matching/*.py
!point_cloud_matching/*.md
!point_cloud_matching/cases/
!point_cloud_matching/cases/**

!stl/
stl/*
!stl/*.stl
!stl/*.3mf
!stl/*.py

!docs/
docs/*
!docs/*.pdf
